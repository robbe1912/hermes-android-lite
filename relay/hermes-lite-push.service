[Unit]
Description=Hermes Lite push relay: tells the app when a cron run ends
After=network-online.target docker.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/hermes-lite-push/hermes_lite_relay.py
User=hermes
Group=hermes
Restart=on-failure
RestartSec=10
# The relay makes one file below /var/lib/hermes-lite-push. It needs nothing else.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hermes-lite-push
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
